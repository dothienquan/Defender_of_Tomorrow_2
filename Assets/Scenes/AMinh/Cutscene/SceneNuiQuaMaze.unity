    - target: {fileID: 4551059195103223762, guid: fc9400523dc3f424da20fd4b23ecb489, type: 3}
      propertyPath: startText
      value: "\u0110\u1EBFn nh\xE0 c\u1EE7a tr\u01B0\u1EDFng l\xE0ng"
      objectReference: {fileID: 0}
    - target: {fileID: 4551059195103223762, guid: fc9400523dc3f424da20fd4b23ecb489, type: 3}
      propertyPath: questLabel
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 4551059195103223762, guid: fc9400523dc3f424da20fd4b23ecb489, type: 3}
      propertyPath: action1Text
      value: "Quan s\xE1t xung quanh v\xE0 t\xECm l\u1ED1i tho\xE1t"
      objectReference: {fileID: 0}
    - target: {fileID: 4551059195103223762, guid: fc9400523dc3f424da20fd4b23ecb489, type: 3}
      propertyPath: action2Text
      value: "Gi\u1EA3i m\xE3 t\u01B0\u1EE3ng n\u1EEF th\u1EA7n"
      objectReference: {fileID: 0}
    - target: {fileID: 4551059195103223762, guid: fc9400523dc3f424da20fd4b23ecb489, type: 3}
      propertyPath: action3Text
      value: "T\xECm ch\xECa kh\xF3a \u0111\u1EC3 m\u1EDF c\u1EEDa h\u1EA7m ng\u1EE5c"
      objectReference: {fileID: 0}
    - target: {fileID: 4551059195103223762, guid: fc9400523dc3f424da20fd4b23ecb489, type: 3}
      propertyPath: action4Text
      value: "Thu th\u1EADp m\u1EA3nh kim c\u01B0\u01A1ng \u0111\u1EC3 m\u1EDF kh\xF3a
        h\u1EA7m ng\u1EE5c"
      objectReference: {fileID: 0}
    - target: {fileID: 4551059195103223762, guid: fc9400523dc3f424da20fd4b23ecb489, type: 3}
      propertyPath: action5Text
      value: "\u0110\xE1nh b\u1EA1i Cthulu"
      objectReference: {fileID: 0}
    - target: {fileID: 4551059195103223762, guid: fc9400523dc3f424da20fd4b23ecb489, type: 3}
      propertyPath: action6Text
      value: "Di chuy\u1EC3n \u0111\u1EBFn v\xF9ng n\xFAi ph\xEDa b\u1EAFc..."
      objectReference: {fileID: 0}
    - target: {fileID: 4551059195103223762, guid: fc9400523dc3f424da20fd4b23ecb489, type: 3}
      propertyPath: action7Text
      value: "Kh\xE1m ph\xE1 khu v\u1EF1c xung quanh"
      objectReference: {fileID: 0}
    - target: {fileID: 4551059195103223762, guid: fc9400523dc3f424da20fd4b23ecb489, type: 3}
      propertyPath: action8Text
      value: "T\xECm c\xE1ch qua s\xF4ng"
      objectReference: {fileID: 0}
    - target: {fileID: 4551059195103223762, guid: fc9400523dc3f424da20fd4b23ecb489, type: 3}
