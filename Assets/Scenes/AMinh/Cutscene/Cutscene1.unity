  m_Script: {fileID: 11500000, guid: b2ee93073d85779428ee4b330eee3385, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TypingEffect
  textUI: {fileID: 1087789955}
  lines:
  - "T\u1EEB x\u01B0a, c\xE1c b\u1EADc hi\u1EC1n tri\u1EBFt \u0111\xE3 ti\xEAn tri
    v\u1EC1..."
  - "Ng\xE0y Xi\u1EC1ng X\xEDch"
  - "Ng\xE0y m\xE0 s\u1EF1 c\xE2n b\u1EB1ng b\u1ECB ph\xE1 v\u1EE1"
  - "Con qu\xE1i v\u1EADt b\u1ECB giam c\u1EA7m n\u01A1i Aethelgard s\u1EBD tr\u1ED7i
    d\u1EADy"
  - "L\u1EDDi ti\xEAn tri \u0111\xE3 \u0111\xFAng v\u1EC1 vi\u1EC7c nh\u1EEFng Ng\u01B0\u1EDDi
    H\u1ED9 V\u1EC7 s\u1EBD th\u1EA5t b\u1EA1i trong vi\u1EC7c phong \u1EA5n"
  - "B\u1EA3n th\xE2n l\xE0 ng\u01B0\u1EDDi ti\u1EC1n nhi\u1EC7m, ch\u1EA3 ph\u1EA3i
    \u0111\u1EBFn l\xFAc ho\xE0n th\xE0nh tr\xE1ch nhi\u1EC7m c\u1EE7a m\xECnh r\u1ED3i
    sao?"
  - "T\xECm l\u1EA5y ta"
  - "Ta s\u1EBD l\xE0 \xE1nh \u0111\xE8n soi s\xE1ng con \u0111\u01B0\u1EDDng c\u1EE7a
    ng\u01B0\u01A1i"
  typingDurationPerLine: 2
  delayBetweenLines: 2
  autoStart: 1
  waitForInput: 0
