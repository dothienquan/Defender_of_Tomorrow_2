  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TypingEffect
  textUI: {fileID: 1087789955}
  lines:
  - Tu xua cac bac hien triet da tien tri ve
  - Ngay Xieng Xich Vo
  - Ngay ma su can bang bi pha vo
  - Con quai vat bi giam cam noi Aethelgard duoc tu do
  - Loi tien tri da dung ve viec nhung Nguoi Ho Ve da that bai trong viec phong an..
  - Ban than la nguoi tien nhiem, chang phai da den luc nguoi hoan thanh trach nhiem
    cua minh roi sao?
  - Tim lay ta
  - Ta se la anh sang soi duong cho nguoi
  typingDurationPerLine: 2
  delayBetweenLines: 2
  autoStart: 1
  waitForInput: 0
