  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2fabfc503d1abde4ab2527103056f87a, type: 3}
  m_Name: NPC2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueObject
  lines:
  - "H\xE3y c\u1EA9n th\u1EADn v\u1EDBi khu v\u1EF1c ph\xEDa tr\u01B0\u1EDBc, kh\xF4ng
    c\xF3 nhi\u1EC1u ng\u01B0\u1EDDi may m\u1EAFn v\u01B0\u1EE3t qua \u0111\xE2u."
  dialogueLines:
  - speakerName: "D\u0169ng S\u0129"
    text: "Xin ch\xE0o."
    avatar: {fileID: 1220073278, guid: 2cd166603c891cf4abad8bd3355ffbb4, type: 3}
  - speakerName: Caffa
    text: "Ch\xE0o, m\xECnh l\xE0 Caffa, kh\xF4ng bi\u1EBFt c\xF3 th\u1EC3 gi\xFAp
      g\xEC b\u1EA1n?"
    avatar: {fileID: -7786770284008050647, guid: 1e715b7a992caea4bbeeaf9ece049e5a, type: 3}
  - speakerName: "D\u0169ng S\u0129"
    text: "M\xECnh \u0111ang mu\u1ED1n \u0111\u1EBFn ch\u1ED7 s\u01B0 ph\u1EE5 Orlan,
      b\u1EA1n c\xF3 bi\u1EBFt ai l\xE0 ng\u01B0\u1EDDi s\u1EDF h\u1EEFu ch\xECa
      kh\xF3a h\u1EA7m ng\u1EE5c kh\xF4ng?"
    avatar: {fileID: 1220073278, guid: 2cd166603c891cf4abad8bd3355ffbb4, type: 3}
  - speakerName: Caffa
    text: "C\xF3\u2026 nh\u01B0ng n\xF3i ra th\xEC h\u01A1i ng\u1EA1i. M\xECnh \u0111\xE3
      l\xE0m r\u01A1i n\xF3 l\xFAc \u0111i s\u0103n, r\u1ED3i b\u1ECB m\u1ED9t con
      goblin cu\u1ED7m m\u1EA5t."
    avatar: {fileID: -7786770284008050647, guid: 1e715b7a992caea4bbeeaf9ece049e5a, type: 3}
  - speakerName: Caffa
    text: "B\u1ECDn goblin th\u01B0\u1EDDng t\u1EE5 t\u1EADp \u1EDF g\u1EA7n c\u1EEDa
      hang, b\u1EA1n s\u1EBD t\xECm \u0111\u01B0\u1EE3c ch\xECa kh\xF3a sau khi h\u1EA1
      b\u1ECDn ch\xFAng."
    avatar: {fileID: -7786770284008050647, guid: 1e715b7a992caea4bbeeaf9ece049e5a, type: 3}
  - speakerName: "D\u0169ng S\u0129"
    text: "M\xECnh c\u1EA3m \u01A1n."
    avatar: {fileID: 1220073278, guid: 2cd166603c891cf4abad8bd3355ffbb4, type: 3}
