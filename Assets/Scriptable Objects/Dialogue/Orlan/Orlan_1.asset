  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2fabfc503d1abde4ab2527103056f87a, type: 3}
  m_Name: Orlan_1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueObject
  lines:
  - ...
  - "\u0110\xE2y ch\u1EC9nh l\xE0 sinh v\u1EADt do s\u01B0 ph\u1EE5 Orlan t\u1EA1o
    ra \u0111\u1EC3 th\u1EED th\xE1ch c\xE1c d\u0169ng s\u0129!"
  - "H\xE3y c\u1EA9n th\u1EADn v\u1EDBi kh\u1EA3 n\u0103ng ph\xE2n th\xE2n c\u1EE7a
    n\xF3."
  - "Ch\u1EC9 \u0111\xE1nh v\xE0o b\u1EA3n th\u1EC3 th\u1EADt m\u1EDBi c\xF3 th\u1EC3
    l\xE0m n\xF3 m\u1EA5t m\xE1u."
  dialogueLines:
  - speakerName: ???
    text: "K\u1EBB n\xE0o d\xE1m b\xE9n m\u1EA3ng \u0111\u1EBFn n\u01A1i \u1EDF c\u1EE7a
      ta?"
    avatar: {fileID: 5879008522838223929, guid: b0b50d8d18554174f918feabacbda058, type: 3}
  - speakerName: "D\u0169ng s\u0129"
    text: "T\xF4i l\xE0 d\u0169ng s\u0129, \u0111\u01B0\u1EE3c ti\xEAn linh Lillia
      d\u1EABn \u0111\u01B0\u1EDDng \u0111\u1EC3 t\xECm s\u01B0 ph\u1EE5 Orlan ng\u01B0\u1EDDi
      n\u1EAFm gi\u1EEF m\u1EA3nh \u0111\xE1 linh h\u1ED3n."
    avatar: {fileID: 1220073278, guid: 2cd166603c891cf4abad8bd3355ffbb4, type: 3}
  - speakerName: Orlan
    text: "Th\xEC ra l\xE0 k\u1EBB phong \u1EA5n Elder ti\u1EBFp theo. Ta l\xE0 Orlan,
      \u0111\u1EC3 xem ng\u01B0\u01A1i c\xF3 \u0111\u1EE7 th\u1EF1c l\u1EF1c hay
      kh\xF4ng. H\xE3y g\u1EB7p ta \u1EDF b\xEAn kia c\xE1nh c\u1ED5ng."
    avatar: {fileID: 5879008522838223929, guid: b0b50d8d18554174f918feabacbda058, type: 3}
