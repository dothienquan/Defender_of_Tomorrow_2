  m_Script: {fileID: 11500000, guid: 2fabfc503d1abde4ab2527103056f87a, type: 3}
  m_Name: NPC Sett
  m_EditorClassIdentifier: Assembly-CSharp::DialogueObject
  lines:
  - "Kh\xE1 l\u1EAFm nh\xF3c con."
  - "\u0110\xFAng l\xE0 ng\u01B0\u1EDDi \u0111\u01B0\u1EE3c ch\u1ECDn."
  - "Ng\u01B0\u01A1i \u0111\xE3 c\xF3 kh\u1EA3 n\u0103ng phong \u1EA5n con qu\xE1i
    v\u1EADt \u0111\xF3."
  - "B\u01B0\u1EDBc qua c\xE1nh c\u1ED5ng..."
  - "...v\xE0 ch\u1EA5m d\u1EE9t c\u01A1n \xE1c m\u1ED9ng n\xE0y."
  dialogueLines:
  - speakerName: "S\u01B0 ph\u1EE5 Sett"
    text: "Kh\xE1 l\u1EAFm nh\xF3c con, kh\xF4ng h\u1ED5 danh l\xE0 ng\u01B0\u1EDDi
      \u0111\u01B0\u1EE3c ch\u1ECDn."
    avatar: {fileID: 21300000, guid: 5e3131a00b3858e448f351a45e386143, type: 3}
  - speakerName: "S\u01B0 ph\u1EE5 Sett"
    text: "\u0110\xE2y l\xE0 nh\u1EEFng nguy\xEAn li\xEAu c\u1EA7n thi\u1EBFt."
    avatar: {fileID: 21300000, guid: 5e3131a00b3858e448f351a45e386143, type: 3}
  - speakerName: "S\u01B0 ph\u1EE5 Orlan"
    text: "Lillia, h\xE3y b\u1EAFt \u0111\u1EA7u th\u1EF1c hi\u1EC7n nghi th\u1EE9c."
    avatar: {fileID: -6305445818414768842, guid: 965129c9d015a0f439cd7d9d44b95d27, type: 3}
  - speakerName: Lillia
    text: "\u0110\xE3 r\xF5!"
    avatar: {fileID: 6997756701569904062, guid: 5e788416833f3c44c8503f397fdf428a, type: 3}
  - speakerName: Lillia
    text: "D\u0169ng s\u0129, ch\xFAc may m\u1EAFn."
    avatar: {fileID: 6997756701569904062, guid: 5e788416833f3c44c8503f397fdf428a, type: 3}
