  m_Script: {fileID: 11500000, guid: 2fabfc503d1abde4ab2527103056f87a, type: 3}
  m_Name: SettDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueObject
  lines:
  - "\u0110\xE2y l\xE0 \u0111\u1ECBa ph\u1EADn c\u1EE7a ta."
  - "Ta l\xE0 Sett, ng\u01B0\u1EDDi gi\u1EEF \u1EA4n S\u1EE9c M\u1EA1nh."
  - "\u1EDE \u0111\xE2y kh\xF4ng c\xF3 tri\u1EBFt l\xFD g\xEC c\u1EA3, ch\u1EC9 c\xF3
    k\u1EBB m\u1EA1nh nh\u1EA5t v\xE0 k\u1EBB thua cu\u1ED9c d\u01B0\u1EDBi ch\xE2n
    k\u1EBB kia."
  - "Ph\xEDa b\xEAn kia l\xE0 \u0111\u1EA5u tr\u01B0\u1EDDng do ta t\u1EA1o ra"
  - "N\u1EBFu ng\u01B0\u01A1i chi\u1EBFn th\u1EAFng \u0111\u01B0\u1EE3c \u0111\u1EA5u
    tr\u01B0\u1EDDng th\xEC ta s\u1EBD c\xF4ng nh\xE2n ng\u01B0\u01A1i l\xE0 Ng\u01B0\u1EDDi
    \u0111\u01B0\u1EE3c ch\u1ECDn"
  dialogueLines: []
